        <div class="button-row">
          <button id="goToChallengeBtn" class="primary-btn" type="button">Open Challenge</button>
          <button id="hintBtn" class="secondary-btn" type="button">Hint: What’s Next?</button>
        </div>
      </article>
    </section>
  </main>

  <nav class="bottom-nav">
