      <article class="card">
        <div class="challenge-pill" id="challengePill">Challenge 1 of 16</div>
        <h2 class="challenge-title" id="challengeTitle">Loading challenge...</h2>
        <p class="challenge-brief" id="challengeBrief"></p>

        <div class="meta-grid">
          <div class="meta-box" id="timerBox">
            <div class="meta-label" id="timerLabel">Timer</div>
            <div class="meta-value" id="timerDisplay">00:00:00</div>
          </div>
          <div class="meta-box">
            <div class="meta-label">Duration</div>
            <div class="meta-value" id="durationDisplay">24 hrs</div>
