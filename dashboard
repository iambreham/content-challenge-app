        <p class="welcome" id="welcomeText">Loading your dashboard...</p>

        <div class="day-line">
          <div class="day-count" id="dayCountText">Day 1 of 30</div>
          <p class="reminder-inline" id="motivationMessage">
            You do not need to reinvent yourself every morning. You need to finish the assignment.
          </p>
        </div>
      </div>

      <button id="logoutBtn" class="logout-btn" type="button">Log Out</button>
    </section>

    <div id="loadingState" class="loading show">Loading dashboard...</div>
    <div id="errorState" class="error-state"></div>

    <section id="dashboardContent" class="dashboard">
      <article class="card">
