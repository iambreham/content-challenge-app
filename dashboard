        brief: "Create one piece of content that combines a strong hook, movement, cleaner editing, and a clear CTA.",
        duration: 72,
        hint: "You’re at the final challenge."
      }
    ];

    const reminderMessages = [
      "You do not need to reinvent yourself every morning. You need to finish the assignment.",
      "Some of y’all confuse overthinking with effort. They are not the same thing.",
      "Your content does not need another identity crisis. It needs follow-through.",
      "Post the thing, learn from the thing, then move on. Very simple. Very grown.",
      "Not every video needs a spiritual breakthrough. Some of them just need to be posted.",
      "If you keep waiting until it feels perfect, you’re going to be waiting forever and annoying yourself.",
      "The girls who grow are usually the girls who stop negotiating with themselves every day."
    ];

    const greetingHeading = document.getElementById("greetingHeading");
    const welcomeText = document.getElementById("welcomeText");
    const dayCountText = document.getElementById("dayCountText");
    const loadingState = document.getElementById("loadingState");
    const errorState = document.getElementById("errorState");
    const dashboardContent = document.getElementById("dashboardContent");
    const calendarGrid = document.getElementById("calendarGrid");
    const challengePill = document.getElementById("challengePill");
    const challengeTitle = document.getElementById("challengeTitle");
    const challengeBrief = document.getElementById("challengeBrief");
    const timerDisplay = document.getElementById("timerDisplay");
    const timerLabel = document.getElementById("timerLabel");
    const timerBox = document.getElementById("timerBox");
    const durationDisplay = document.getElementById("durationDisplay");
    const motivationMessage = document.getElementById("motivationMessage");
    const todayFocusText = document.getElementById("todayFocusText");
    const logoutBtn = document.getElementById("logoutBtn");
    const goToChallengeBtn = document.getElementById("goToChallengeBtn");
    const hintBtn = document.getElementById("hintBtn");

    let timerInterval = null;
    let activeChallenge = null;

    function getGreetingByTime() {
      const hour = new Date().getHours();
      if (hour < 12) return "Good morning";
      if (hour < 17) return "Good afternoon";
      return "Good evening";
    }

    function formatClock(totalMs) {
      const totalSeconds = Math.floor(Math.abs(totalMs) / 1000);
      const hours = Math.floor(totalSeconds / 3600);
      const minutes = Math.floor((totalSeconds % 3600) / 60);
      const seconds = totalSeconds % 60;

      return [
        String(hours).padStart(2, "0"),
        String(minutes).padStart(2, "0"),
        String(seconds).padStart(2, "0")
      ].join(":");
    }

    function startChallengeTimer(challengeStartDate, durationHours) {
      if (timerInterval) clearInterval(timerInterval);

      const endTime = challengeStartDate.getTime() + durationHours * 60 * 60 * 1000;

      function updateTimer() {
        const now = Date.now();
        const delta = endTime - now;

        if (delta >= 0) {
          timerLabel.textContent = "Timer";
          timerDisplay.textContent = `${formatClock(delta)} left`;
          timerDisplay.classList.remove("overdue");
          timerBox.classList.remove("overdue");
          challengePill.classList.remove("overdue");
        } else {
          timerLabel.textContent = "Past Due";
          timerDisplay.textContent = `${formatClock(delta)} overdue`;
          timerDisplay.classList.add("overdue");
          timerBox.classList.add("overdue");
          challengePill.classList.add("overdue");
        }
      }

      updateTimer();
      timerInterval = setInterval(updateTimer, 1000);
    }

    function showError(message) {
      loadingState.classList.remove("show");
      dashboardContent.style.display = "none";
      errorState.classList.add("show");
      errorState.textContent = message;
    }

    function getDayDifference(startDate, currentDate) {
      const start = new Date(startDate);
      const current = new Date(currentDate);

      start.setHours(0, 0, 0, 0);
      current.setHours(0, 0, 0, 0);

      const diffMs = current.getTime() - start.getTime();
      return Math.floor(diffMs / (1000 * 60 * 60 * 24));
    }

    function getWeekStart(date) {
      const d = new Date(date);
      const day = d.getDay();
      const diff = d.getDate() - day;
      d.setDate(diff);
      d.setHours(0, 0, 0, 0);
      return d;
    }

    function buildWeekView(programStartDate, activeChallengeNumber) {
      calendarGrid.innerHTML = "";

      const today = new Date();
      const weekStart = getWeekStart(today);

      for (let i = 0; i < 7; i++) {
        const tileDate = new Date(weekStart);
        tileDate.setDate(weekStart.getDate() + i);

        const tile = document.createElement("div");
        tile.className = "day-tile";

        const dayIndexRaw = getDayDifference(programStartDate, tileDate);
        const dayNumber = dayIndexRaw + 1;

        const isToday = tileDate.toDateString() === today.toDateString();
        const isWithinProgram = dayNumber >= 1 && dayNumber <= 30;
        const isCompleted = isWithinProgram && dayNumber < activeChallengeNumber;
        const isActiveChallenge = isWithinProgram && dayNumber === activeChallengeNumber;

        let statusText = "Outside";
        let emoji = "";

        if (isCompleted) {
          tile.classList.add("completed");
          statusText = "Done";
          emoji = "🎉";
        } else if (isActiveChallenge) {
          tile.classList.add("active-challenge");
          statusText = "Active";
        } else if (isWithinProgram) {
          statusText = "Upcoming";
        }

        if (isToday) {
          tile.classList.add("today");
        }

        const dayName = tileDate.toLocaleDateString(undefined, { weekday: "short" });
        const monthDay = tileDate.toLocaleDateString(undefined, { month: "short", day: "numeric" });

        tile.innerHTML = `
          ${emoji ? `<div class="celebrate">${emoji}</div>` : ""}
          <div class="day-number">${dayName}</div>
          <div class="day-date">${monthDay}</div>
          <div class="day-status">${isWithinProgram ? `Day ${dayNumber} • ${statusText}` : "Not started"}</div>
        `;

        calendarGrid.appendChild(tile);
      }
    }

    function getReminderMessage(currentDayNumber) {
      return reminderMessages[(currentDayNumber - 1) % reminderMessages.length];
    }

    function getTodayFocus(challenge, isOverdue) {
      if (!challenge) {
        return "Show up, finish the thing, and resist the urge to overcomplicate it.";
      }

      const title = challenge.title;

      if (isOverdue) {
        return `You’re late on ${title}. Cute. Finish it anyway so you can unlock the next challenge and keep it moving.`;
      }

      if (title === "Collect Your Wins") {
        return "Today is not about forcing more content out of yourself. Review what you’ve done, breathe, and actually acknowledge the progress.";
      }

      return `Today’s focus is ${title}. Do the assignment, finish the assignment, and resist turning one task into a full-blown identity crisis.`;
    }

    async function loadDashboard(user) {
      const userRef = doc(db, "users", user.uid);
      const userSnap = await getDoc(userRef);

      if (!userSnap.exists()) {
        showError("We couldn’t find your challenge data. Go back to login and create your account again.");
        return;
      }

      const userData = userSnap.data();
      const name = userData.name ? String(userData.name).trim() : "creator";
      const currentChallengeNumber = userData.currentChallenge || 1;
      activeChallenge = challenges.find(ch => ch.id === currentChallengeNumber) || challenges[0];

      let programStartDate = new Date();
      if (userData.programStartDate?.toDate) {
        programStartDate = userData.programStartDate.toDate();
      } else if (userData.createdAt?.toDate) {
        programStartDate = userData.createdAt.toDate();
      }

      let activeChallengeStartDate = new Date();
      if (userData.startTime?.toDate) {
        activeChallengeStartDate = userData.startTime.toDate();
      }

      const greeting = getGreetingByTime();
      const todayIndexRaw = getDayDifference(programStartDate, new Date());
      const todayIndex = Math.max(0, Math.min(todayIndexRaw, 29));
      const currentDayNumber = todayIndex + 1;

      const endTime = activeChallengeStartDate.getTime() + activeChallenge.duration * 60 * 60 * 1000;
      const isOverdue = Date.now() > endTime;

      greetingHeading.textContent = `${greeting}, ${name}`;
      welcomeText.textContent = `You’re here. Good.`;
      dayCountText.textContent = `Day ${currentDayNumber} of 30`;
      motivationMessage.textContent = getReminderMessage(currentDayNumber);

      buildWeekView(programStartDate, currentChallengeNumber);

      challengePill.textContent = `Challenge ${activeChallenge.id} of ${challenges.length}`;
      challengeTitle.textContent = activeChallenge.title;
      challengeBrief.textContent = activeChallenge.brief;
      durationDisplay.textContent = `${activeChallenge.duration} hrs`;
      todayFocusText.textContent = getTodayFocus(activeChallenge, isOverdue);

      startChallengeTimer(activeChallengeStartDate, activeChallenge.duration);

      loadingState.classList.remove("show");
      errorState.classList.remove("show");
      dashboardContent.style.display = "grid";
    }

    logoutBtn.addEventListener("click", async () => {
      await signOut(auth);
      window.location.href = "./index.html";
    });

    goToChallengeBtn.addEventListener("click", () => {
      window.location.href = "./challenge.html";
    });

    hintBtn.addEventListener("click", () => {
      if (!activeChallenge) return;
      alert(activeChallenge.hint || "Next up: more clarity, less chaos.");
    });

    onAuthStateChanged(auth, async (user) => {
      if (!user) {
        window.location.href = "./index.html";
        return;
      }

      try {
        await loadDashboard(user);
      } catch (error) {
        showError("Something went wrong loading your dashboard.");
        console.error(error);
      }
    });
  </script>
</body>
</html>