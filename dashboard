<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>mycreativehq | Dashboard</title>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Instrument+Serif:ital@0;1&display=swap"
    rel="stylesheet"
  />

  <style>
    :root {
      --cream: #fcfaf5;
      --warm-white: #fffdf9;
      --vanilla: #f6f1e8;
      --lavender: #e9e0fb;
      --blush: #ffe4da;
      --sky: #e3efff;

      --green: #8caf49;
      --green-dark: #789845;
      --green-soft: rgba(140, 175, 73, 0.14);
      --green-softer: rgba(140, 175, 73, 0.08);

      --ink: #161616;
      --text: #4b4b4b;
      --muted: #757575;

      --glass: rgba(255, 255, 255, 0.68);
      --border: rgba(255, 255, 255, 0.82);
      --shadow: 0 24px 60px rgba(92, 74, 112, 0.08);

      --nav-bg: rgba(255, 255, 255, 0.8);
      --dark-btn: #111111;
      --dark-btn-hover: #000000;

      --today-ring: #cfc1ff;
      --complete-bg: rgba(140, 175, 73, 0.18);
      --upcoming-bg: rgba(255, 255, 255, 0.52);
      --overdue-bg: rgba(255, 231, 226, 0.84);
      --overdue-text: #944838;
      --overdue-border: rgba(200, 108, 84, 0.16);
    }

    * {
      box-sizing: border-box;
    }

    html,
    body {
      margin: 0;
      padding: 0;
      min-height: 100%;
    }

    body {
      font-family: "Inter", sans-serif;
      color: var(--text);
      min-height: 100vh;
      padding: 28px 24px 120px;
      overflow-x: hidden;
      position: relative;
      background:
        radial-gradient(circle at 10% 16%, rgba(255,255,255,0.92), transparent 24%),
        radial-gradient(circle at 88% 14%, rgba(233,224,251,0.76), transparent 20%),
        radial-gradient(circle at 84% 82%, rgba(255,228,218,0.72), transparent 18%),
        radial-gradient(circle at 16% 82%, rgba(227,239,255,0.72), transparent 18%),
        linear-gradient(145deg, var(--cream) 0%, var(--vanilla) 100%);
    }

    .ambient {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 0;
      overflow: hidden;
    }

    .blob {
      position: absolute;
      border-radius: 999px;
      filter: blur(36px);
      opacity: 0.72;
    }

    .blob-1 {
      width: 260px;
      height: 260px;
      background: rgba(233, 224, 251, 0.62);
      top: 18px;
      left: 10px;
    }

    .blob-2 {
      width: 240px;
      height: 240px;
      background: rgba(255, 228, 218, 0.58);
      top: 80px;
      right: 80px;
    }

    .blob-3 {
      width: 220px;
      height: 220px;
      background: rgba(227, 239, 255, 0.6);
      bottom: 80px;
      left: 80px;
    }

    .blob-4 {
      width: 280px;
      height: 280px;
      background: rgba(255, 255, 255, 0.74);
      bottom: 10px;
      right: 20px;
    }

    .app {
      position: relative;
      z-index: 1;
      max-width: 820px;
      margin: 0 auto;
    }

    .topbar {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 18px;
      margin-bottom: 24px;
    }

    .brand {
      margin: 0 0 10px;
      font-family: "Instrument Serif", serif;
      font-size: 28px;
      line-height: 1;
      color: #4e6132;
      letter-spacing: 0.01em;
    }

    .eyebrow {
      margin: 0 0 10px;
      font-size: 13px;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: rgba(22,22,22,0.46);
    }

    .page-title {
      margin: 0;
      font-size: clamp(42px, 5vw, 74px);
      line-height: 0.94;
      letter-spacing: -0.055em;
      color: var(--ink);
      max-width: 720px;
    }

    .welcome {
      margin: 16px 0 0;
      max-width: 760px;
      font-size: 21px;
      line-height: 1.45;
      color: rgba(22,22,22,0.62);
    }

    .logout-btn {
      border: none;
      border-radius: 18px;
      background: rgba(255,255,255,0.72);
      border: 1px solid rgba(255,255,255,0.82);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      color: var(--ink);
      font-size: 15px;
      font-weight: 800;
      padding: 16px 18px;
      cursor: pointer;
      box-shadow: 0 10px 22px rgba(92, 74, 112, 0.08);
      transition: transform 0.16s ease, background 0.2s ease;
    }

    .logout-btn:hover {
      transform: translateY(-1px);
      background: rgba(255,255,255,0.88);
    }

    .day-line {
      margin-top: 24px;
    }

    .day-count {
      font-size: 16px;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: rgba(22,22,22,0.5);
      margin-bottom: 10px;
    }

    .reminder-inline {
      margin: 0;
      font-size: 20px;
      line-height: 1.6;
      color: rgba(22,22,22,0.72);
      max-width: 760px;
    }

    .loading,
    .error-state {
      display: none;
      padding: 36px 0;
      font-size: 18px;
      font-weight: 700;
      color: rgba(22,22,22,0.62);
    }

    .loading.show,
    .error-state.show {
      display: block;
    }

    .dashboard {
      display: none;
      grid-template-columns: 1fr;
      gap: 22px;
      align-items: start;
    }

    .card {
      border-radius: 30px;
      padding: 28px;
      background: var(--glass);
      border: 1px solid var(--border);
      backdrop-filter: blur(22px);
      -webkit-backdrop-filter: blur(22px);
      box-shadow: var(--shadow);
    }

    .section-title {
      margin: 0 0 10px;
      font-size: clamp(28px, 3vw, 40px);
      line-height: 1;
      letter-spacing: -0.045em;
      color: var(--ink);
    }

    .week-strip {
      display: grid;
      grid-template-columns: repeat(7, minmax(0, 1fr));
      gap: 10px;
    }

    .day-tile {
      min-height: 96px;
      border-radius: 22px;
      padding: 12px 10px;
      background: var(--upcoming-bg);
      border: 1px solid rgba(255,255,255,0.78);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      box-shadow: inset 0 1px 0 rgba(255,255,255,0.28);
      position: relative;
      overflow: hidden;
    }

    .day-tile.completed {
      background: var(--complete-bg);
      border-color: rgba(140,175,73,0.18);
    }

    .day-tile.today {
      background: rgba(255,255,255,0.92);
      border: 2px solid var(--today-ring);
      box-shadow: 0 10px 24px rgba(207, 193, 255, 0.2);
    }

    .day-tile.active-challenge {
      background: var(--green-softer);
    }

    .celebrate {
      position: absolute;
      top: 10px;
      right: 10px;
      font-size: 14px;
      line-height: 1;
    }

    .day-number {
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: rgba(22,22,22,0.46);
    }

    .day-date {
      font-size: 18px;
      font-weight: 800;
      letter-spacing: -0.04em;
      color: var(--ink);
    }

    .day-status {
      font-size: 12px;
      font-weight: 700;
      color: rgba(22,22,22,0.56);
      line-height: 1.3;
    }

    .focus-card {
      background: linear-gradient(
        135deg,
        rgba(233,224,251,0.36),
        rgba(255,255,255,0.72)
      );
    }

    .mini-title {
      margin: 0 0 10px;
      font-size: 24px;
      line-height: 1.08;
      letter-spacing: -0.04em;
      color: var(--ink);
    }

    .mini-text {
      margin: 0;
      color: rgba(22,22,22,0.7);
      line-height: 1.7;
      font-size: 16px;
    }

    .challenge-pill {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 10px 14px;
      border-radius: 999px;
      background: var(--green-soft);
      color: #58722f;
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      margin-bottom: 16px;
    }

    .challenge-pill.overdue {
      background: var(--overdue-bg);
      color: var(--overdue-text);
    }

    .challenge-title {
      margin: 0 0 14px;
      font-size: clamp(30px, 3.1vw, 42px);
      line-height: 1.02;
      letter-spacing: -0.045em;
      color: var(--ink);
    }

    .challenge-brief {
      margin: 0;
      font-size: 17px;
      line-height: 1.65;
      color: rgba(22,22,22,0.68);
    }

    .meta-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
      margin: 24px 0;
    }

    .meta-box {
      border-radius: 22px;
      background: rgba(255,255,255,0.56);
      padding: 18px;
      border: 1px solid rgba(255,255,255,0.82);
    }

    .meta-box.overdue {
      background: var(--overdue-bg);
      border-color: var(--overdue-border);
    }

    .meta-label {
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: rgba(22,22,22,0.44);
      margin-bottom: 8px;
    }

    .meta-value {
      font-size: 26px;
      font-weight: 800;
      color: var(--ink);
      letter-spacing: -0.04em;
      line-height: 1.1;
    }

    .meta-value.overdue {
      color: var(--overdue-text);
    }

    .button-row {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
    }

    .primary-btn,
    .secondary-btn {
      border: none;
      border-radius: 20px;
      height: 64px;
      padding: 0 22px;
      font-size: 18px;
      font-weight: 800;
      cursor: pointer;
      transition: transform 0.16s ease, background 0.2s ease, box-shadow 0.2s ease;
    }

    .primary-btn:hover,
    .secondary-btn:hover {
      transform: translateY(-1px);
    }

    .primary-btn {
      background: var(--green);
      color: #ffffff;
      box-shadow: 0 14px 28px rgba(120, 152, 69, 0.22);
    }

    .primary-btn:hover {
      background: var(--green-dark);
    }

    .secondary-btn {
      background: var(--dark-btn);
      color: #ffffff;
      box-shadow: 0 14px 28px rgba(17,17,17,0.14);
    }

    .secondary-btn:hover {
      background: var(--dark-btn-hover);
    }

    .bottom-nav {
      position: fixed;
      left: 50%;
      bottom: 20px;
      transform: translateX(-50%);
      width: min(760px, calc(100% - 24px));
      z-index: 10;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 10px;
      padding: 12px;
      border-radius: 24px;
      background: var(--nav-bg);
      border: 1px solid rgba(255,255,255,0.88);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      box-shadow: 0 18px 44px rgba(92, 74, 112, 0.12);
    }

    .nav-link {
      display: flex;
      align-items: center;
      justify-content: center;
      text-decoration: none;
      height: 58px;
      border-radius: 18px;
      font-size: 15px;
      font-weight: 800;
      color: rgba(22,22,22,0.62);
      background: transparent;
      transition: background 0.2s ease, color 0.2s ease;
    }

    .nav-link.active {
      background: var(--green);
      color: #ffffff;
      box-shadow: 0 10px 20px rgba(120, 152, 69, 0.2);
    }

    @media (max-width: 900px) {
      .topbar {
        flex-direction: column;
        align-items: flex-start;
      }

      .page-title {
        font-size: 52px;
      }

      .welcome,
      .reminder-inline {
        font-size: 18px;
      }

      .week-strip {
        grid-template-columns: repeat(4, minmax(0, 1fr));
      }

      .meta-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 640px) {
      body {
        padding: 18px 16px 110px;
      }

      .card {
        padding: 22px;
        border-radius: 24px;
      }

      .week-strip {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .page-title {
        font-size: 44px;
      }

      .challenge-title,
      .section-title {
        font-size: 30px;
      }

      .meta-value {
        font-size: 22px;
      }

      .button-row {
        flex-direction: column;
      }

      .primary-btn,
      .secondary-btn {
        width: 100%;
      }
    }
  </style>
</head>
<body>
  <div class="ambient">
    <div class="blob blob-1"></div>
    <div class="blob blob-2"></div>
    <div class="blob blob-3"></div>
    <div class="blob blob-4"></div>
